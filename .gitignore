# ============================================================
# .gitignore — Static Web Page Project
# ============================================================

# ---------------------------
# CI/CD build output
# ---------------------------
# public/           # created at CI runtime (GitLab); not committed to repo

# ---------------------------
# OS generated files
# ---------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.nfs*

# ---------------------------
# Code editors & IDEs
# ---------------------------

# VS Code
.vscode/
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
Session.vim

# Emacs
*#
.emacs.desktop

# ---------------------------
# Node.js (if added later)
# ---------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/cache
.pnp.*

# ---------------------------
# Environment & secrets
# ---------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------
# Logs & temp files
# ---------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.orig

# ---------------------------
# Personal / project notes
# ---------------------------
notes*.txt
TODO.md
SCRATCH.md
